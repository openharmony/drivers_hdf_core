import("./../../hdf.gni")

# CMSIS-RTOS2 based OSAL implementation. Small RTOS kernels (liteos_m,
# freertos, rtthread) share this implementation. The kernel_module template
# comes from the target kernel's liteos.gni (imported by ../hdf.gni).
module_switch = defined(LOSCFG_DRIVERS_HDF)
hdf_driver("hdf_osal_cmsis") {
  sources = [
    "src/osal_mem.c",
    "src/osal_mutex.c",
    "src/osal_sem.c",
    "src/osal_spinlock.c",
    "src/osal_thread.c",
    "src/osal_time.c",
    "src/osal_timer.c",
  ]

  # liteos_m extend extension implementation of OsalExtendXxx.
  if (ohos_kernel_type == "liteos_m") {
    sources += [ "../extend/liteos_m/osal_extend_impl.c" ]
  }

  include_dirs = [
    "include",
    "../include",
    "//drivers/hdf_core/interfaces/inner_api/osal/shared",
    "//drivers/hdf_core/interfaces/inner_api/utils",
    "//drivers/hdf_core/framework/include",
    "//drivers/hdf_core/framework/include/osal",
    "//third_party/cmsis/CMSIS/RTOS2/Include",
  ]

  deps = [ "//base/hiviewdfx/hilog_lite/frameworks/featured:hilog_static" ]
}

config("public") {
  include_dirs = [
    "include",
    "../include",
    "../extend",
  ]
}
