# ===================================================================
# Central khdf adapter dispatch layer.
# ===================================================================
# This file is NEWLY INTRODUCED. The khdf tree previously had no
# top-level dispatch: each vendor product's hdf_config/BUILD.gn
# hard-coded the platform import (e.g. khdf/liteos_m/hdf.gni).
#
# ohos_kernel_type is set by the hb tool from the product config.json
# "kernel_type" field (see build/lite/ohos_var.gni:70-71). Supported
# values: "liteos_a", "liteos_m", "linux", "uniproton".
# "freertos" / "rtthread" are future kernels not yet in the tree.
#
# Products import this file, then import("$hdf_khdf_path/hdf.gni")
# instead of hard-coding a platform path.
# ===================================================================

if (ohos_kernel_type == "liteos_m" || ohos_kernel_type == "freertos" ||
    ohos_kernel_type == "rtthread") {
  hdf_khdf_path = "//drivers/hdf_core/adapter/khdf/liteos_m"
} else {
  assert(false, "unsupported ohos_kernel_type for khdf: " + ohos_kernel_type)
}
